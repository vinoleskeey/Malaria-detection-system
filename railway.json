{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements.txt",
    "startCommand": "gunicorn app_fixed:app --workers 1 --timeout 300"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "env": {
    "SECRET_KEY": {
      "description": "Flask secret key for sessions",
      "generateValue": true
    },
    "DEVELOPER_EMAIL": {
      "description": "Your email address - only this email can access staff features",
      "value": "victorshittu17@gmail.com"
    },
    "MAIL_USERNAME": {
      "description": "Your Gmail address for password reset emails",
      "value": "victorshittu17@gmail.com"
    },
    "MAIL_PASSWORD": {
      "description": "Your Gmail app password for password reset emails",
      "value": "ifyg knbp oxbv izpk"
    },
    "WEB_URL": {
      "description": "Your Railway app URL for password reset links",
      "value": "https://web-production-e60045.up.railway.app"
    }
  }
}
